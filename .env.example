# API Keys — copy to .env (never commit .env)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-...           # optional, only if using --backend openai
ANTHROPIC_API_KEY=sk-ant-...    # optional, only if using --backend anthropic
OPENROUTER_API_KEY=sk-or-...    # optional, only if using --backend openrouter
